# ──────────────────────────────────────────────
# Clonetube — Variables de entorno (Backend)
# Copiar a .env y ajustar según el entorno
# ──────────────────────────────────────────────

# ─── AWS / MinIO (S3-compatible) ─────────────
# Credenciales de acceso para MinIO (usuario root por defecto en el contenedor docker-compose)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Región AWS simulada (MinIO la ignora, pero boto3 la requiere)
AWS_REGION=us-east-1

# Nombre del bucket donde se almacenan los videos
AWS_BUCKET_NAME=clonetube-videos

# URL del endpoint S3 (MinIO corriendo localmente en docker-compose)
S3_ENDPOINT_URL=http://localhost:9000

# URL pública del endpoint S3 para generar URLs prefirmadas accesibles desde el navegador.
# En Docker Compose: http://localhost:9000 (MinIO expuesto directamente al host).
# En desarrollo local (sin Docker): dejar vacío para usar el mismo que S3_ENDPOINT_URL.
# El navegador debe poder acceder directamente a esta URL (sin proxy nginx).
S3_PUBLIC_ENDPOINT_URL=

# ─── Base de datos (MariaDB) ─────────────────
# Cadena de conexión: mysql+pymysql://usuario:contraseña@host:puerto/base_de_datos
# El driver pymysql es necesario para la conexión asíncrona con SQLAlchemy
DATABASE_URL=mysql+pymysql://clonetube:clonetube@localhost:3306/clonetube
