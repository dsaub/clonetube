# Solo empaqueta el jar ya compilado en CI (backend/target/*.jar, construido
# una sola vez en el runner nativo); no compila por arquitectura.

FROM eclipse-temurin:25-jre-alpine

ARG OTEL_VERSION=2.28.1

RUN apk add --no-cache curl \
    && addgroup -S app \
    && adduser -S app -G app \
    && curl -fL \
       "https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_VERSION}/opentelemetry-javaagent.jar" \
       -o /opt/opentelemetry-javaagent.jar \
    && test -s /opt/opentelemetry-javaagent.jar

WORKDIR /app

COPY target/*.jar app.jar

RUN chown app:app /app/app.jar /opt/opentelemetry-javaagent.jar

USER app

EXPOSE 8080

ENTRYPOINT [
  "java",
  "-javaagent:/opt/opentelemetry-javaagent.jar",
  "-jar",
  "app.jar"
]