# ──────────────────────────────────────────────
# Clonetube — Variables de entorno (Deploy)
# Copiar a .env y ajustar según el entorno
# ──────────────────────────────────────────────

# ─── MariaDB ──────────────────────────────────
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=clonetube
MARIADB_USER=clonetube
MARIADB_PASSWORD=password

# ─── MinIO ────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── AWS / S3 (MinIO) ─────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_BUCKET_NAME=clonetube
S3_ENDPOINT_URL=http://minio:9000

# ─── Base de datos ──────────────────────────
DATABASE_URL=mysql+pymysql://clonetube:password@mariadb:3306/clonetube
