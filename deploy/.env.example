# ──────────────────────────────────────────────
# Clonetube — Variables de entorno (Deploy)
# Copiar a .env y ajustar según el entorno
# ──────────────────────────────────────────────

# ─── MariaDB ──────────────────────────────────
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=clonetube
MARIADB_USER=clonetube
MARIADB_PASSWORD=password
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/clonetube
SPRING_DATASOURCE_USERNAME=clonetube
SPRING_DATASOURCE_PASSWORD=password

# ─── MinIO ────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=eu-west-3
AWS_BUCKET_NAME=clonetube
S3_ENDPOINT_URL=http://minio:9000

# URL pública de S3: la usa el navegador para subir los fragmentos y reproducir.
# DEBE apuntar al mismo MinIO que S3_ENDPOINT_URL. Con el proxy de nginx basta
# con el dominio del sitio (ver el location ^/<bucket>/videos/ en nginx.conf).
# Si apunta a otro sitio, la subida falla con 404 (NoSuchUpload).
S3_PUBLIC_ENDPOINT_URL=https://TU-DOMINIO

# ─── Seguridad ────────────────────────────────
JWT_SECRET=cambiar-por-clave-segura-de-al-menos-32-byts

# ─── Dominio público ──────────────────────────
DOMAIN=https://TU-DOMINIO
POINTS_SUCCESS_URL=https://TU-DOMINIO/points/success
POINTS_CANCEL_URL=https://TU-DOMINIO/points/cancel

# ─── Sistema de puntos: pasarelas de pago ────
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── Emails / worker ──────────────────────────
SQS_QUEUE_URL=""
SMTP_HOST=mail.elordenador.org
SMTP_PORT=465
SMTP_USERNAME=notificaciones@elordenador.org
SMTP_PASSWORD=tu_contraseña
SMTP_FROM=notificaciones@elordenador.org
