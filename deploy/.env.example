# ──────────────────────────────────────────────
# Clonetube — Variables de entorno (Producción)
# Copiar a .env en deploy/app/ y deploy/workers/,
# ajustar según el entorno.
# ──────────────────────────────────────────────

# ─── MariaDB ──────────────────────────────────
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=clonetube
MARIADB_USER=clonetube
MARIADB_PASSWORD=password
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/clonetube
SPRING_DATASOURCE_USERNAME=clonetube
SPRING_DATASOURCE_PASSWORD=password

# ─── MinIO / S3 ───────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=eu-west-3
AWS_BUCKET_NAME=clonetube
# Endpoint S3 que usa el backend. Con MinIO externo, pon su IP/FQDN real y
# accesible desde el contenedor (p. ej. http://10.0.0.5:9000 o https://minio.midominio.com).
# Con AWS S3 deja VACÍA esta variable: el SDK usara https://s3.<region>.amazonaws.com.
# IMPORTANTE: el hostname "minio" del stack de desarrollo NO existe en produccion.
S3_ENDPOINT_URL=

# Base de lectura pública. El backend añade la clave videos/<id>.mp4.
# Puede ser una distribución CloudFront o incluir un prefijo de ruta si el
# origen lo necesita. Si queda vacía, el vídeo se sirve mediante la API.
S3_PUBLIC_ENDPOINT_URL=https://XXXXXXXXXXXXXX.cloudfront.net

# ─── Seguridad ────────────────────────────────
JWT_SECRET=cambiar-por-clave-segura-de-al-menos-32-byts

# ─── Dominio público ──────────────────────────
DOMAIN=https://TU-DOMINIO
POINTS_SUCCESS_URL=https://TU-DOMINIO/points/success
POINTS_CANCEL_URL=https://TU-DOMINIO/points/cancel

# ─── Sistema de puntos: pasarelas de pago ────
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── Emails / worker ──────────────────────────
SQS_QUEUE_URL=""
VIDEO_TRANSCODE_QUEUE_URL=""
SMTP_HOST=mail.elordenador.org
SMTP_PORT=465
SMTP_USERNAME=notificaciones@elordenador.org
SMTP_PASSWORD=tu_contraseña
SMTP_FROM=notificaciones@elordenador.org

# Worker de vídeo: 100 GiB de entrada, 6 h por proceso y heartbeat SQS cada 60 s.
VIDEO_VISIBILITY_TIMEOUT=900
VIDEO_VISIBILITY_HEARTBEAT_SECONDS=60
VIDEO_TRANSCODE_TIMEOUT_SECONDS=21600
MAX_VIDEO_BYTES=107374182400

# Opentelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=prueba
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer (token)"