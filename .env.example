# ============================================================================
# clonetube — variables de entorno
# Copia este archivo a `.env` y completa los valores.
# ============================================================================

# --- Base de datos (MariaDB) -----------------------------------------------
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=clonetube
MARIADB_USER=clonetube
MARIADB_PASSWORD=password
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/clonetube
SPRING_DATASOURCE_USERNAME=clonetube
SPRING_DATASOURCE_PASSWORD=password

# --- MinIO / S3 -------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_BUCKET_NAME=clonetube
S3_ENDPOINT_URL=http://minio:9000
# Base de lectura pública. Se añade la clave del objeto (videos/<id>.mp4).
# Para CloudFront: https://XXXXXXXXXXXXXX.cloudfront.net
S3_PUBLIC_ENDPOINT_URL=

# --- Seguridad --------------------------------------------------------------
JWT_SECRET=cambiar-por-clave-segura-de-al-menos-32-byts

# --- Dominio público --------------------------------------------------------
DOMAIN=http://localhost

# --- Sistema de puntos ------------------------------------------------------
# URLs de retorno tras completar/cancelar un pago.
POINTS_SUCCESS_URL=http://localhost/points/success
POINTS_CANCEL_URL=http://localhost/points/cancel

# Pasarela Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com

# Pasarela PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Emails (worker) --------------------------------------------------------
SQS_QUEUE_URL=
VIDEO_TRANSCODE_QUEUE_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Transcodificación de vídeo --------------------------------------------
VIDEO_VISIBILITY_TIMEOUT=900
VIDEO_VISIBILITY_HEARTBEAT_SECONDS=60
VIDEO_TRANSCODE_TIMEOUT_SECONDS=21600
MAX_VIDEO_BYTES=107374182400
